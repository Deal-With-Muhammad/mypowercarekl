# Copy to .env.local and fill in. All are optional in development.

# Public site URL (used for canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://klelectrician.com

# Google Analytics 4 measurement ID (Admin > Data streams > Web)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Optional: Google Tag Manager container instead of / as well as GA4
NEXT_PUBLIC_GTM_ID=
# Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Supabase (Project Settings > API). The publishable/anon key is safe here:
# Row Level Security only lets it INSERT into the leads table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
